{
  "name": "@mailpilot/api",
  "version": "2.29.2",
  "description": "CLI tool for managing Mail Pilot through the external API",
  "keywords": [
    "mail-pilot",
    "api",
    "cli",
    "automation"
  ],
  
  "type": "module",
  "bin": {
    "mail-pilot-api": "bin/mail-pilot-api.js"
  },
  "files": [
    "bin"
  ],
  "scripts": {
    "build": "bun build src/main.ts --outfile bin/mail-pilot-api.js --target node",
    "dev": "bun run src/main.ts",
    "prepublishOnly": "bun run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
