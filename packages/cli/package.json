{
  "name": "@mailpilot/cli",
  "version": "2.29.2",
  "description": "CLI tool for setting up and managing Mail Pilot - AI email assistant",
  "keywords": [
    "mail-pilot",
    "email",
    "cli",
    "setup"
  ],
  "type": "module",
  "bin": {
    "mail-pilot": "bin/mail-pilot.js"
  },
  "files": [
    "bin"
  ],
  "scripts": {
    "build": "bun build src/main.ts --outfile bin/mail-pilot.js --target node",
    "build:binary": "bun build src/main.ts --compile --outfile dist/mail-pilot",
    "build:binary:all": "pnpm build:binary:macos-arm64 && pnpm build:binary:macos-x64 && pnpm build:binary:linux-x64",
    "build:binary:linux-x64": "bun build src/main.ts --compile --target=bun-linux-x64 --outfile dist/mail-pilot-linux-x64",
    "build:binary:macos-arm64": "bun build src/main.ts --compile --target=bun-darwin-arm64 --outfile dist/mail-pilot-darwin-arm64",
    "build:binary:macos-x64": "bun build src/main.ts --compile --target=bun-darwin-x64 --outfile dist/mail-pilot-darwin-x64",
    "dev": "bun run src/main.ts",
    "prepublishOnly": "bun run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "1.9.0",
    "commander": "15.1.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
