{
  "name": "@mailpilot/mail-sqlite",
  "version": "0.1.0",
  "private": true,
  "description": "Shared SQLite mailbox schema, queries, and transactional store",
  
  "homepage": "https://github.com/areal/mailpilot/tree/main/packages/mail-sqlite#readme",
  "bugs": {
    "url": "https://github.com/areal/mailpilot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/areal/mailpilot.git",
    "directory": "packages/mail-sqlite"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./driver": "./src/driver.ts",
    "./store": "./src/store.ts",
    "./migrations": "./src/migrations.ts",
    "./maintenance": "./src/maintenance.ts",
    "./node": "./src/node-sqlite.ts",
    "./capabilities": "./src/capabilities.ts",
    "./test-support/driver-contract": "./test-support/driver-contract.ts"
  },
  "scripts": {
    "build": "node scripts/clean-package.mjs && tsc -p tsconfig.build.json && node scripts/prepare-package.mjs",
    "pack:check": "pnpm run build && cd dist && pnpm pack --dry-run",
    "pack:smoke": "node ../mail-core/scripts/pack-consumer-smoke.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check-imports": "node scripts/check-imports.mjs"
  },
  "dependencies": {
    "@mailpilot/mail-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
